{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "grep *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "sort *": "allow",
      "find *": "allow",
      "uniq *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "echo *": "allow",
      "git diff *": "allow",
    },
    "lsp": "allow",
    "read": "allow",
    "edit": {
      "*": "allow",
      "opencode.jsonc": "ask",
      "coding_source": "deny",
    },
    "glob": "allow",
    "grep": "allow",
    "question": "allow",
    "list": "allow",
    "glossary": "allow",
  }
}
