{
  "name": "luci-bachelor",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check:pages": "node ./pages-check.mjs",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "server:dev": "pnpm --filter kodakool-server dev",
    "server:start": "pnpm --filter kodakool-server start",
    "server:check": "pnpm --filter kodakool-server check",
    "server:test": "pnpm --filter kodakool-server test",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@opencode-ai/plugin": "^1.18.31",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26.6.2",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.12",
    "lib0": "^0.2.114",
    "mdsvex": "^0.12.7",
    "playwright": "~1.63.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "sass": "^1.104.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^2.1.1",
    "y-protocols": "^1.0.6"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@material/material-color-utilities": "^0.4.0",
    "bits-ui": "^2.19.5",
    "hono": "^4.13.13",
    "jose": "6.2.12",
    "material-symbols": "^0.47.5",
    "melt": "^0.44.0",
    "oidc-client-ts": "^3.5.0",
    "openid-client": "^6.8.8",
    "paneforge": "^1.0.2",
    "rxdb": "^17.5.0",
    "sql.js": "^1.15.1",
    "unpdf": "^1.8.1",
    "y-codemirror.next": "^0.3.6",
    "y-websocket": "^2.0.2",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  }
}
