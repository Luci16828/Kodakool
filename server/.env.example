# Session JWT signing key — REQUIRED, at least 32 characters
SECRET=change-me-to-a-long-random-string-of-32+-chars

# Listen (defaults shown)
#PORT=8787
#HOST=0.0.0.0

# SQLite data directory (defaults shown)
#DATA_DIR=./data

# 0 = invite-only: disable username/password registration
#ALLOW_REGISTER=1

# Comma-separated OIDC issuer allow-list; empty allows any https issuer
#OIDC_ALLOW=https://auth.example.com,https://id.example.org
